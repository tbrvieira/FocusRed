<?xml version="1.0" encoding="utf-8"?>
<!-- Strong red card. Drawn opaque here; OverlayService applies the user's
     opacity setting (default 75%) through the drawable's alpha. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFB91C1C" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1.5dp"
        android:color="#FFEF4444" />
</shape>
